<!-- File: res/layout/activity_main.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="#1B2631">
    <!-- Khung Card chứa thông tin sinh viên -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#243342">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">
            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_avatar"
                android:contentDescription="@string/avatar_description" />
            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp" />
            <TextView
                android:id="@+id/tvStudentId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#DCE6EB"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/tvGpaBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#34B469"
                android:layout_marginTop="12dp" />
            <EditText
                android:id="@+id/edtNewGpa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="@string/hint_new_gpa"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:autofillHints="none"
                android:layout_marginTop="16dp" />
            <Button
                android:id="@+id/btnUpdateGpa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_update_gpa"
                android:backgroundTint="#34B469"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>